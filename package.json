{
  "name": "zeo",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "e2e": "pnpm --filter @zeo/e2e run e2e",
    "dev": "pnpm -r --parallel run dev",
    "format": "prettier --write ."
  },
  "pnpm": {
    "overrides": {
      "electron": "44.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.5.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
